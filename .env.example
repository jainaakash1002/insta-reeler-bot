# Required: the token @BotFather gives you after /newbot
BOT_TOKEN=

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Send /start to your bot to see your ID. Leave empty to let anyone use it.
ALLOWED_USER_IDS=

# Optional: how many screenshots the "Get screenshots" button sends (1-10, default 6)
SCREENSHOT_COUNT=6

# Instagram login. Needed for stories and highlights; also helps if Instagram starts refusing
# downloads ("login required" / "rate limit"). Reels and posts work without it.
# Use ONE of these. Prefer a secondary Instagram account; automated downloads can get an account flagged.
#   Browser you're logged into Instagram with: chrome, firefox, brave, edge, safari
IG_COOKIES_FROM_BROWSER=
#   Or a cookies.txt file exported from that browser
IG_COOKIES_FILE=

# Reddit login, needed for Reddit links (Reddit blocks anonymous downloads and no longer issues API keys):
# a cookies.txt exported from a browser logged into Reddit (spare account). See the README.
# REDDIT_COOKIES_FILE=/full/path/to/cookies-reddit.txt
# The owner's Telegram user ID(s), comma-separated. Only they may download Reddit links and use /chatid,
# and their downloads aren't copied to ARCHIVE_CHAT_ID (empty: everyone counts as owner).
# Old name: REDDIT_USER_IDS (still read when OWNER_USER_IDS isn't set).
# OWNER_USER_IDS=
# A chat (e.g. your private group; get its id with /chatid@<bot username> there) that gets a copy of
# everything other users download. Users in OWNER_USER_IDS aren't copied. The bot must be in that chat.
# ARCHIVE_CHAT_ID=
# Only these Telegram user IDs get the screenshot buttons (unset: same as OWNER_USER_IDS; all: everyone)
# SCREENSHOT_USER_IDS=

# Or an old Reddit API key, if you have one (takes precedence).
# Free: reddit.com/prefs/apps -> "create another app" -> type "script", redirect uri http://localhost
# The ID is under the app's name, the secret next to "secret". No Reddit account login is used.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Only on a host that sleeps when idle (e.g. Render's free Web Service): the service's https address.
# Telegram then sends messages to <WEBHOOK_URL>/telegram instead of the bot polling. Leave empty locally.
# WEBHOOK_URL=https://insta-reel-bot.onrender.com

# Optional: paths to the tools if they're not on PATH
# YTDLP_PATH=/opt/homebrew/bin/yt-dlp
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
