# Required: the token @BotFather gives you after /newbot
BOT_TOKEN=

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Send /start to your bot to see your ID. Leave empty to let anyone use it.
ALLOWED_USER_IDS=

# Optional: how many screenshots the "Get screenshots" button sends (1-10, default 6)
SCREENSHOT_COUNT=6

# Instagram login. Needed for stories and highlights; also helps if Instagram starts refusing
# downloads ("login required" / "rate limit"). Reels and posts work without it.
# Use ONE of these. Prefer a secondary Instagram account; automated downloads can get an account flagged.
#   Browser you're logged into Instagram with: chrome, firefox, brave, edge, safari
IG_COOKIES_FROM_BROWSER=
#   Or a cookies.txt file exported from that browser
IG_COOKIES_FILE=

# Optional: paths to the tools if they're not on PATH
# YTDLP_PATH=/opt/homebrew/bin/yt-dlp
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
